# =====================================================================
# NAMARA PLATFORM 環境変数の例
# このファイルをコピーして .env.local を作り、必要な値だけ設定してください。
# .env.local は Git に入りません。APIキーやパスワードは絶対にコミットしないでください。
# Phase 1（現在）はどれも未設定のままでデモが動きます。
# =====================================================================

# --- アプリ ---
# 公開URL（LINE の Flex Message 内リンクに使用）。ローカルは未設定でOK
NEXT_PUBLIC_APP_URL=
# 本番ビルド（npm run build && npm start）でデモログインを使うときだけ 1。公開環境では絶対に 1 にしない
NAMARA_DEMO_MODE=

# --- 利用者識別子の保護（本番必須・32文字以上のランダム文字列） ---
# 例：openssl rand -hex 32 で作成。変更すると既存の利用者と紐づかなくなるので注意
IDENTITY_HASH_SECRET=

# --- Supabase（Phase 2 で接続） ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。ブラウザに渡さないこと（NEXT_PUBLIC_ を付けない）
SUPABASE_SERVICE_ROLE_KEY=

# --- LINE：なまらAI（消費者向けチャネル／Phase 7） ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# 1 のときだけ実際に LINE へ返信する（未設定ならモックに記録するだけ）
LINE_REPLY_ENABLED=

# --- LINE：NAMARA REVIEW 店舗通知（消費者向けとは別チャネル／Phase 9） ---
LINE_STORE_NOTIFY_CHANNEL_SECRET=
LINE_STORE_NOTIFY_ACCESS_TOKEN=

# --- OpenAI（Phase 3 後半以降で検討。有料） ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Google（Phase 8。API利用申請・承認後） ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
