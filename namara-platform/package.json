{
  "name": "namara-platform",
  "version": "0.1.0",
  "private": true,
  "description": "なまらAI（消費者向けLINEグルメ検索）と NAMARA REVIEW（飲食店向けSaaS）の統合プラットフォーム",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
