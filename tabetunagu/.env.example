# ------------------------------------------------------------
# TABETUNAGU（食べつなぐ） 環境変数サンプル
# .env.local にコピーして値を設定してください（.env.local は Git にコミットされません）。
# すべて未設定でも `npm run dev` で動きます（組み込み DB + デモログイン）。
# NEXT_PUBLIC_ が付く値だけがブラウザに公開されます。秘密情報には付けないこと。
# ------------------------------------------------------------

# 公開 URL（LINE Login のコールバック・QR の URL に使用）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 環境: development | preview | production（未設定時は VERCEL_ENV から判定）
# production ではデモログインが常に無効になり、AUTH_SECRET / QR_SIGNING_SECRET が必須になります。
APP_ENV=

# ---- データベース（Supabase PostgreSQL） ----------------------
# Supabase → Project Settings → Database → Connection string（Transaction pooler, :6543 推奨）
# 未設定のときはローカルの組み込み PostgreSQL（PGlite, .data/pglite）を使います。
DATABASE_URL=
DATABASE_POOL_MAX=5
# ローカル PGlite の保存先（memory で揮発）
PGLITE_DATA_DIR=

# ---- Supabase（画像ストレージ用） -----------------------------
NEXT_PUBLIC_SUPABASE_URL=
# 現在の実装ではブラウザから Supabase に直接アクセスしません（将来の Realtime 等用・任意）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー専用。絶対にクライアントへ渡さない（NEXT_PUBLIC_ を付けない）
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# ---- 認証・署名（32文字以上のランダム文字列。本番必須） --------
# 生成例: openssl rand -base64 48
AUTH_SECRET=
# 店舗QRの署名鍵。変更するとすべての印刷済みQRが無効になります
QR_SIGNING_SECRET=

# ---- デモログイン（開発確認用） --------------------------------
# 未設定: next dev のときだけ有効 / true: 有効（プレビュー環境など） / false: 無効
# APP_ENV=production では設定にかかわらず無効
ENABLE_DEMO_LOGIN=

# ---- LINE ------------------------------------------------------
# LIFF アプリ ID（LINE Login チャネルに作成）
NEXT_PUBLIC_LIFF_ID=
# LINE Login チャネル（ID トークンの検証・Web ログイン）
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# Messaging API チャネルのアクセストークン（まとめ通知の送信。未設定なら dry run）
LINE_CHANNEL_ACCESS_TOKEN=

# ---- OpenAI（AI 販売文章生成。未設定ならテンプレート生成） -----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ---- v2（事前決済）の購入導線 -----------------------------------
# true: 商品詳細の「食べつなぐ」・ナビ・マイページを v2（事前決済・受取チケット）にする。
# 未設定・false: 旧導線（予約 → 店頭 QR → お店で支払い）。production は明示的に true にしない限り OFF。
# production で true にする前に README「v2 本番導線 ON の条件」を満たすこと。false に戻せば即時に旧導線へ戻る。
ENABLE_V2_CHECKOUT=

# ---- Stripe（v2 事前決済・Connect。サーバー専用） -----------------
# 未設定なら購入（決済）と売上受取設定は「準備中」になります。NEXT_PUBLIC_ を付けないこと。
# Stripe Checkout を使うため、公開可能キー（pk_）は不要です。
STRIPE_SECRET_KEY=
# Webhook の署名鍵（ダッシュボードの Webhook 設定、または stripe listen が表示する whsec_...）
STRIPE_WEBHOOK_SECRET=
# Checkout から戻る先のベース URL（未設定なら NEXT_PUBLIC_APP_URL）。
# LINE ミニアプリ / LIFF 内に戻す場合: https://liff.line.me/<LIFF ID>
STRIPE_CHECKOUT_RETURN_URL=
# 使う決済手段を固定する Payment Method Configuration の ID（pmc_...。例: カードのみ）。任意
STRIPE_PAYMENT_METHOD_CONFIGURATION=

# ---- Vercel Cron（/api/cron/* の認証） --------------------------
CRON_SECRET=
