# NAMARA REVIEW 環境変数の例
# このファイルをコピーして .env.local を作り、値を入れてください（.env.local は Git に保存されません）。
# Phase 1（現在）は外部サービスに接続しないため、どれも設定不要です。

# ── アプリ ──────────────────────────────────────────
# 本番のURL（OAuth・LINE のコールバックURLに使う）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase（Phase 2）───────────────────────────────
# NEXT_PUBLIC_ が付くものはブラウザに公開される前提の値
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# サーバー専用。絶対に NEXT_PUBLIC_ を付けない・ブラウザに渡さない
SUPABASE_SECRET_KEY=

# ── Google Business Profile API（Phase 3）──────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Google のリフレッシュトークンをDBに暗号化保存するための鍵（32バイト以上のランダム値）
TOKEN_ENCRYPTION_KEY=

# ── OpenAI（Phase 4）────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=

# ── LINE Messaging API（Phase 5）─────────────────────
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# ── 定期実行（Phase 3〜）─────────────────────────────
# Vercel Cron などから口コミ同期APIを呼ぶときの共有シークレット
CRON_SECRET=
