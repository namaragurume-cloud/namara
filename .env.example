# ------------------------------------------------------------
# なまらグルメ キャスティングサイト 環境変数サンプル
# このファイルを .env.local にコピーして値を設定してください。
# .env.local は Git にコミットされません。
# ------------------------------------------------------------

# 公開URL（canonical / OGP / sitemap に使用）。独自ドメイン決定後に変更。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- フォーム通知 ------------------------------------------
# 送信方式: resend | formspree | console（console はローカル開発専用。本番では無効）
# 未設定の場合、フォームは「送信準備中」と表示され送信できません。
MAIL_PROVIDER=

# 通知の宛先（企業問い合わせ・発信者登録とも共通）
MAIL_TO=namaragurume@gmail.com

# Resend を使う場合（https://resend.com）
#   送信元ドメインを Resend で認証してから MAIL_FROM を設定してください。
RESEND_API_KEY=
MAIL_FROM="なまらグルメ <noreply@example.com>"

# Formspree を使う場合（https://formspree.io）
#   フォームIDのみ（https://formspree.io/f/xxxxxxx の xxxxxxx 部分）
#   FORMSPREE_PARTNER_FORM_ID を空にすると、発信者登録も企業問い合わせ用のフォームに届きます（件名で区別）
FORMSPREE_CONTACT_FORM_ID=
FORMSPREE_PARTNER_FORM_ID=

# ---- Bot 対策（任意・推奨） ---------------------------------
# Cloudflare Turnstile。両方設定すると有効になります。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Instagram フォロワー数の自動取得（任意） ----------------
# 設定するとトップの数値と発信者カードのフォロワー数が6時間ごとに自動更新されます。
# 取得できるのはプロアカウント（ビジネス／クリエイター）のみ。手順は README を参照。
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_GRAPH_VERSION=v23.0

# ---- アクセス解析（任意） -----------------------------------
# Google Analytics 4 の測定ID（例: G-XXXXXXXXXX）。
# 同意管理（Cookieバナー等）の方針を決めてから設定してください。
NEXT_PUBLIC_GA_ID=

# ---- 非公開コンテンツのプレビュー（ローカル確認用） ----------
# true にすると published: false の実績・発信者も表示します。
# 本番（VERCEL_ENV=production / NODE_ENV=production の next start）では無視されます。
CONTENT_PREVIEW=false
